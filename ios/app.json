{
  "expo": {
    "name": "Tally",
    "slug": "tally",
    "version": "4.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tally",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anthonyradke.tally",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.anthonyradke.tally",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-scene-delegate",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Tally shows a picture of your card that you choose from Photos.",
          "cameraPermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tally uses Face ID to keep your finances private."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
